      ],
      "objectives": [
        {
          "kind": "goto",
          "id": "reach_mile",
          "label": "Get to the Neon Mile",
          "position": [300, 1, 60],
          "radius": 6,
          "marker": { "label": "Neon Mile", "waypoint": true }
        }
      ]
    },
    {
      "id": "muscle",
      "title": "Lean on the crew",
      "checkpoint": true,
      "onEnter": [
        { "kind": "dialogue", "speaker": "Mac", "line": "They want to do this the hard way. Fine." },
        { "kind": "setWanted", "stars": 2 },
        {
          "kind": "spawnEnemies",
          "ref": "crew",
          "archetype": "gangster",
          "position": [308, 1, 70],
          "count": 4,
          "radius": 6,
          "weapon": "pistol",
          "behavior": "attack"
        }
      ],
      "objectives": [
        {
          "kind": "eliminate",
          "id": "clear_crew",
          "label": "Take out the crew",
          "targets": { "spawnRef": "crew" },
          "medalTag": "clean_sweep",
          "marker": { "color": "#ff5a5a" }
        }
      ]
    },
    {
      "id": "collect",
      "title": "Collect the debt",
      "onEnter": [
        { "kind": "spawnProp", "ref": "debt", "model": "cash", "position": [304, 1, 66] },
        { "kind": "spawnProp", "ref": "debt", "model": "cash", "position": [312, 1, 74] },
        { "kind": "spawnProp", "ref": "debt", "model": "cash", "position": [300, 1, 78] }
