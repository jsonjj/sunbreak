  "rewards": [
    { "kind": "cash", "amount": 3000 },
    { "kind": "rep", "amount": 150 },
    { "kind": "weapon", "weaponId": "shotgun" },
    { "kind": "unlockMission", "missionId": "m05_airfield_getaway" }
