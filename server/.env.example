# SUNBREAK server env. Copy to server/.env and fill in.
# server/.env is gitignored — the key NEVER reaches the client bundle (server-proxied only).

# The ONLY required secret — but NOT needed to boot v0. Get one at:
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional overrides (safe defaults if omitted)
OPENAI_MODEL=gpt-4o-mini
PORT=8787
CLIENT_ORIGIN=http://localhost:5173
AI_RATE_LIMIT_PER_MIN=20
DATABASE_PATH=./data/sunbreak.db
